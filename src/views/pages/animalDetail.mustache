{{>partials/header}}

{{#notFound}}
  <div class="container no-list">
    <h2>Animal não encontrado!</h2>
  </div>
{{/notFound}}

{{#animal}}
  <div class="container">
    <h2>{{name}}</h2>
    <img src="/images/{{image}}" alt="{{name}}" style="max-width:300px; width:100%; border-radius:10px; margin:20px 0;" />
    <p><strong>Tipo:</strong> {{type}}</p>
    <p><strong>Cor:</strong> {{color}}</p>
    <p><strong>Sexo:</strong> {{sex}}</p>
  </div>
{{/animal}}

{{>partials/footer}}
